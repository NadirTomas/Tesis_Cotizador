# Variables de entorno para CotizaLaser (backend).
# Sin prefijo (env_prefix="" en app/core/config.py) -- Railway inyecta
# DATABASE_URL directo, así que los nombres tienen que coincidir tal cual.

# Obligatoria: sin esto el backend no arranca (falla en startup, sin default inseguro).
SECRET_KEY=cambiame-por-una-clave-larga-y-aleatoria-en-produccion

# Por defecto cae a SQLite local si no se define. En Railway, Postgres se
# inyecta solo (no hace falta setearla a mano).
DATABASE_URL=sqlite:///./cotizalaser.db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/cotizalaser

# URL del frontend en producción, para CORS. Vacía en local.
FRONTEND_URL=

# Clave para POST /admin/companies (alta de empresas por el desarrollador).
# Vacía = endpoint deshabilitado por completo.
ADMIN_SECRET=

# Límites de subida (bytes). Los valores de abajo son los defaults reales.
MAX_DXF_SIZE=10485760
MAX_LOGO_SIZE=5242880
